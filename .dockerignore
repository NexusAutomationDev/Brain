# .dockerignore — keep build context tiny + never copy secrets/tests/dev artifacts

# VCS
.git
.gitignore
.gitleaks.toml
.gitleaksignore
.github

# Secrets — NEVER copy
.env
.env.*
!.env.example

# Python dev artifacts
__pycache__
*.py[cod]
*.egg-info
.eggs
.venv
venv
build
dist

# Tests + tooling
tests/
.pytest_cache
.coverage
.coverage.*
htmlcov
coverage.xml
.ruff_cache
.mypy_cache

# IDE / OS
.vscode
.idea
*.swp
.DS_Store
Thumbs.db

# Planning + docs (the running image doesn't need these)
.planning/
docs/
*.md
!README.md
!src/brain/**/README.md

# Docker self
docker-compose*.yml
Dockerfile
docker/

# Lint scripts (only needed at commit time on host)
scripts/lint/

# Pre-commit
.pre-commit-config.yaml

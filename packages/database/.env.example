# PostgreSQL connection
DATABASE_URL=postgresql://user:password@localhost:5432/brain_dev

# Multi-tenancy: database name selected at runtime
DATABASE_NAME=brain_dev

# PGVector: OpenAI text-embedding-3-small = 1536
# WARNING: Cannot be changed after first migration without re-embedding all data
EMBEDDING_DIMENSIONS=1536
# Changing this value requires generating a NEW migration (drizzle-kit generate) —
# the vector(N) dimension is baked into migration SQL at generation time, not read at
# runtime by migrations. See packages/database/src/migrations/0009_embedding_dimensions_fix.sql.

# Connection pool config (per tenant)
DB_POOL_SIZE=15
DB_IDLE_TIMEOUT=300

# Multi-tenant LRU cache
DB_MAX_TENANTS=20

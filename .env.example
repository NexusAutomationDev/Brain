# .env.example — copy to `.env` and fill in <REPLACE_ME> values before `docker compose up`.
# `.env` is gitignored. Never commit a real secret.
#
# Section: Service
BRAIN_ENV=development
BRAIN_LOG_FORMAT=json
BRAIN_LOG_LEVEL=INFO
BRAIN_SUPPORTED_SCHEMA_VERSIONS=1

# Section: Graceful shutdown (FOUND-09, D-13)
BRAIN_SHUTDOWN__GRACE_SECONDS=30

# Section: Auth (AUTH-01; Phase 3 enforces. Pre-commit gitleaks blocks real values here.)
BRAIN_AUTH__TOKEN=<REPLACE_ME>

# Section: Postgres — Brain transactional store (FOUND-06, FOUND-07)
BRAIN_POSTGRES__DSN=postgresql://brain:brain@brain-postgres:5432/brain
BRAIN_POSTGRES__POOL_MIN=2
BRAIN_POSTGRES__POOL_MAX=10

# Section: RabbitMQ (Phase 8 wires consumer; Phase 1 ready-probes the connection)
BRAIN_RABBITMQ__URL=amqp://brain:brain@rabbitmq:5672/
BRAIN_RABBITMQ__PREFETCH=1

# Section: Qdrant (Phase 7 wires; Phase 1 ready-probes /healthz)
BRAIN_QDRANT__URL=http://qdrant:6333
BRAIN_QDRANT__API_KEY=

# Section: Langfuse Brain-side SDK (Phase 4 wires; default ENABLED=false)
BRAIN_LANGFUSE__HOST=http://langfuse-web:3000
BRAIN_LANGFUSE__PUBLIC_KEY=
BRAIN_LANGFUSE__SECRET_KEY=
BRAIN_LANGFUSE__ENABLED=false

# Section: Provider keys (Phase 5 wires; integrator fills these for any real LLM call)
OPENAI_API_KEY=<REPLACE_ME>
GEMINI_API_KEY=<REPLACE_ME>

# ─────────────────────────────────────────────────────────────────
# Langfuse subsystem (consumed by langfuse-web / langfuse-worker / their sidecars).
# NOT consumed by Brain itself — these belong to the Langfuse stack.
# Values below are dev defaults; rotate before any production-style use.
# (D-09: Langfuse sidecar credentials. The "ROOT_USER"/"ROOT_PASSWORD" pattern
#  follows upstream Langfuse compose conventions.)
# ─────────────────────────────────────────────────────────────────
LANGFUSE_NEXTAUTH_SECRET=<REPLACE_ME_64_CHAR_RANDOM>
LANGFUSE_SALT=<REPLACE_ME_64_CHAR_RANDOM>
LANGFUSE_ENCRYPTION_KEY=<REPLACE_ME_64_CHAR_HEX>
LANGFUSE_POSTGRES_PASSWORD=langfuse
LANGFUSE_CLICKHOUSE_PASSWORD=langfuse
LANGFUSE_MINIO_ROOT_USER=minio
LANGFUSE_MINIO_ROOT_PASSWORD=miniominio
LANGFUSE_REDIS_AUTH=langfuse

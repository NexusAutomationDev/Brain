# Database
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/brain
TEST_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/brain_test

# LLM Provider (Phase 2)
LLM_PROVIDER=openai  # openai | anthropic | gemini | openrouter
LLM_MODEL=gpt-4.1-mini
API_KEY=sk-...              

# Embeddings (Phase 2)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Observability — Langfuse (Phase 2, optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Transport (Phase 2)
# TRANSPORT=webhook  # webhook only in v1

# App
NODE_ENV=development
LOG_LEVEL=info

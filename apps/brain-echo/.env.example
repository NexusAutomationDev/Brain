# =============================================================================
# brain-echo — Environment Variables
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://brain:brain@localhost:5432/brain_dev
EMBEDDING_DIMENSIONS=1536

# --- Migrations ---
# Path para a pasta de migrations (relativo ao CWD ou absoluto)
# Em Docker: /app/migrations (via ENV no Dockerfile)
MIGRATIONS_FOLDER=../../packages/database/src/migrations

# --- Transport ---
# Selecione o transport: webhook (HTTP) ou rabbitmq (fila)
TRANSPORT=webhook

# --- Transport: Webhook ---
PORT=3000
ADMIN_TOKEN=change-me-in-production

# --- Transport: RabbitMQ (TRP-03, TRP-04, TRP-05) ---
# Obrigatorio quando TRANSPORT=rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=brain-events
RABBITMQ_DLQ=brain-dlq
# Backoff entre tentativas em ms (default: 1000)
RABBITMQ_RETRY_DELAY_MS=1000

# --- LLM ---
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# --- Resiliência do LLM (erro transitório de provider) ---
# Retries por modelo antes de acionar o fallback. O default do langchain é 6, que leva
# ~87s até o erro propagar — com TRANSPORT=webhook (síncrono) o chamador estoura o
# timeout antes disso e o fallback nunca rodaria. Default do projeto: 2.
# LLM_MAX_RETRIES=2
#
# Cadeia de fallback acionada quando o modelo primário falha com erro TRANSITÓRIO
# (503 "high demand", 429, 5xx, falha de rede). Erros permanentes (4xx de requisição/
# auth) propagam na hora, sem gastar latência do lead. CSV, em ordem de preferência.
# Formato: "model" (mesmo LLM_PROVIDER) ou "provider:model" (cross-provider).
# LLM_FALLBACK_MODELS=gemini-2.5-flash,openai:gpt-4.1-mini
#
# Key por provider — necessária apenas para fallback cross-provider.
# Sem ela, todos os modelos usam API_KEY.
# API_KEY_OPENAI=sk-...
# API_KEY_ANTHROPIC=sk-ant-...
# API_KEY_GEMINI=...


# --- Histórico de Conversa ---
# Número de mensagens enviadas ao LLM por turno (janela de contexto).
# PostgresSaver guarda o histórico COMPLETO — este limite só afeta o que vai ao LLM.
# Default: 40 (20 turnos humano + IA). Configurável por cliente.
# HIST-03: context window — não afeta o histórico armazenado
CONTEXT_WINDOW_MESSAGES=40

# --- Observability ---
# LangSmith tracing (opcional)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=brain-echo

# --- MCP Integration (opcional) ---
# Brain opera normalmente sem MCP — apenas definir MCP_URL para ativar
# MCP_URL=https://webhook.biellil.com.br/mcp/01c8bedd-b8c8-4b40-8d95-e37c203cdd05
# MCP_TOOLS=tool1,tool2      # CSV de nomes de tools; vazio ou ausente = carregar todas
# MCP_AUTH_TOKEN=<bearer-token>  # Ausente = sem autenticação (para servidores locais)

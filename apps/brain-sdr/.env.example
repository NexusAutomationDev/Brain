# =============================================================================
# brain-sdr — Environment Variables
# =============================================================================

# --- Database ---
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me-in-production
DATABASE_NAME=brain
DATABASE_URL=postgresql://postgres:change-me-in-production@host.docker.internal:5432/brain

# --- Migrations ---
# Local: caminho relativo ao CWD (bun run dev a partir da raiz do monorepo)
# Docker: /app/migrations (configurado via ENV no Dockerfile)
MIGRATIONS_FOLDER=../../packages/database/src/migrations

# --- LLM ---
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini

# --- Transport ---
TRANSPORT=webhook
PORT=3001
ADMIN_TOKEN=change-me-in-production

# Token de autenticação para o webhook (Authorization: Bearer <token>)
# Obrigatório — sem este valor o webhook retorna 503 para todos os requests
# Gerar com: openssl rand -hex 32
WEBHOOK_TOKEN=change-me-in-production

# --- Histórico de Conversa ---
# Mensagens enviadas ao LLM por turno (PostgresSaver guarda histórico completo)
CONTEXT_WINDOW_MESSAGES=40

# --- Observability ---
NODE_ENV=development
LOG_LEVEL=info

# --- LangSmith (opcional) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=brain-sdr

# --- RabbitMQ (apenas se TRANSPORT=rabbitmq) ---
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
# RABBITMQ_QUEUE=brain-events
# RABBITMQ_DLQ=brain-dlq
# RABBITMQ_RETRY_DELAY_MS=1000

# --- MCP Integration (opcional) ---
# Brain opera normalmente sem MCP — apenas definir MCP_URL para ativar
# MCP_URL=https://webhook.biellil.com.br/mcp/01c8bedd-b8c8-4b40-8d95-e37c203cdd05
# MCP_TOOLS=tool1,tool2      # CSV de nomes de tools; vazio ou ausente = carregar todas
# MCP_AUTH_TOKEN=<bearer-token>  # Ausente = sem autenticação (para servidores locais)

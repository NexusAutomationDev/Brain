# =============================================================================
# brain-support — Environment Variables
# =============================================================================

# --- Database ---
# D-05: quando este cliente também roda brain-sdr, DATABASE_NAME DEVE ser diferente
# do DATABASE_NAME do brain-sdr (ex: cliente_x_sdr vs cliente_x_suporte) — mesmo
# servidor Postgres, bancos distintos. Cada banco tem sua própria coluna vector(N).
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me-in-production
DATABASE_NAME=brain_suporte
DATABASE_URL=postgresql://postgres:change-me-in-production@host.docker.internal:5432/brain_suporte

# --- Migrations ---
# Local: caminho relativo ao CWD (bun run dev a partir da raiz do monorepo)
# Docker: /app/migrations (configurado via ENV no Dockerfile)
MIGRATIONS_FOLDER=../../packages/database/src/migrations

# --- LLM ---
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini

# --- Embeddings (SUP-04) ---
# Independente do brain-sdr — cada Brain resolve seu próprio IEmbeddingProvider.
# EMBEDDING_PROVIDER ausente = fallback para LLM_PROVIDER (se capaz de gerar embeddings:
# openai/openrouter/gemini) ou "openai" como último fallback.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS deve bater com a coluna vector(N) migrada no banco deste Brain
# (migration 0009). Mudar este valor exige re-rodar a migration para a nova dimensão.
EMBEDDING_DIMENSIONS=1536

# --- Transport ---
TRANSPORT=webhook
PORT=3002
ADMIN_TOKEN=change-me-in-production

# Token de autenticação para o webhook (Authorization: Bearer <token>)
# Obrigatório — sem este valor o webhook retorna 503 para todos os requests
# Gerar com: openssl rand -hex 32
WEBHOOK_TOKEN=change-me-in-production

# --- Histórico de Conversa ---
# Mensagens enviadas ao LLM por turno (PostgresSaver guarda histórico completo)
CONTEXT_WINDOW_MESSAGES=40

# --- Observability ---
NODE_ENV=development
LOG_LEVEL=info

# --- LangSmith (opcional) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=brain-support

# --- RabbitMQ (apenas se TRANSPORT=rabbitmq) ---
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
# RABBITMQ_QUEUE=brain-events
# RABBITMQ_DLQ=brain-dlq
# RABBITMQ_RETRY_DELAY_MS=1000

# --- MCP Integration (opcional) ---
# Brain opera normalmente sem MCP — apenas definir MCP_URL para ativar.
# D-03: mecanismo genérico herdado do core — não usado para pause_session/finish_conversation
# (essas são hardcoded em buildGraph(), ver brain.ts). Disponível para tools externas futuras.
# MCP_URL=https://webhook.biellil.com.br/mcp/<id>
# MCP_TOOLS=tool1,tool2      # CSV de nomes de tools; vazio ou ausente = carregar todas
# MCP_AUTH_TOKEN=<bearer-token>  # Ausente = sem autenticação (para servidores locais)

# --- RAG: Ingest ---
# Token de autenticação para POST /api/v1/ingest (Authorization: Bearer <token>)
# Obrigatório — sem este valor o endpoint retorna 503 (fail-closed)
# Gerar com: openssl rand -hex 32
INGEST_TOKEN=change-me-in-production

# --- Re-embed (opcional) ---
# POST /api/v1/reembed — reprocessa embeddings de knowledge_chunks de uma collection
# usando o provider/modelo atualmente configurado. Reusa INGEST_TOKEN (mesmo Bearer token).
# Body: { "collection": "nome-da-collection" }
